# Copy to .env. RPC credentials must be rpcuser/rpcpassword; rpcauth-only and
# cookie auth are not supported.

# Synced BCH node. Port 8332 is mainnet; tempnet/testnet differ.
RPC_URL="http://127.0.0.1:8332"
RPC_USER="bitcoin"
RPC_PASS="bitcoin"

# One payout address per line. Read-only: the miner never writes this file.
PAYOUT_ADDRESSES="addresses.txt"
# One sentence per line; each is hashed into the coinbase scriptSig.
STRINGS_FILE="strings.txt"

# once | loop | random. Advancement happens only when a block is accepted.
ADDRESS_MODE="loop"
# Cursor file; defaults to <PAYOUT_ADDRESSES>.state.
ADDRESSES_STATE="addresses.txt.state"

NUM_TASKS=20

# auto | on | off. Whether nBits is a function of the block's own timestamp,
# which is what pins the header time below the min-difficulty threshold.
# auto derives it from the chain name (everything except main). Set explicitly
# if the node does not expose this over RPC.
MIN_DIFFICULTY_RULE="auto"
